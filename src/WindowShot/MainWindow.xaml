<Window x:Class="WindowShot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WindowShot"
        Title="窗口截图"
        Icon="app.ico"
        Width="1060"
        Height="720"
        MinWidth="860"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource Panel}"
                BorderBrush="{StaticResource Line}"
                BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="7" Background="{StaticResource Accent}">
                        <TextBlock Text="&#xE722;"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="14"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="窗口截图"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button x:Name="PinButton"
                            Style="{StaticResource IconButton}"
                            Click="PinButton_Click"
                            ToolTip="置顶窗口"
                            AutomationProperties.Name="置顶窗口">
                        <TextBlock x:Name="PinGlyph"
                                   Text="&#xE718;"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="15"
                                   Foreground="{StaticResource TextSecondary}" />
                    </Button>
                    <Button Style="{StaticResource IconButton}"
                            Click="OpenFolderButton_Click"
                            ToolTip="打开保存文件夹"
                            AutomationProperties.Name="打开保存文件夹">
                        <TextBlock Text="&#xE838;"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="16"
                                   Foreground="{StaticResource TextSecondary}" />
                    </Button>
                    <Button x:Name="RefreshButton"
                            Style="{StaticResource IconButton}"
                            Click="RefreshButton_Click"
                            ToolTip="刷新窗口列表"
                            AutomationProperties.Name="刷新窗口列表">
                        <TextBlock x:Name="RefreshGlyph"
                                   Text="&#xE72C;"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="16"
                                   Foreground="{StaticResource TextSecondary}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource Panel}"
                    BorderBrush="{StaticResource Line}"
                    BorderThickness="0,0,1,0">
                <Grid Margin="14,14,14,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <TextBlock Text="窗口" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock x:Name="WindowCountText"
                                   FontSize="11.5"
                                   Foreground="{StaticResource TextMuted}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <Border Grid.Row="1"
                            Margin="0,10,0,8"
                            Height="34"
                            Background="#F7F9FC"
                            BorderBrush="#DCE3EC"
                            BorderThickness="1"
                            CornerRadius="6">
                        <Grid>
                            <TextBlock Text="&#xE721;"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="13"
                                       Foreground="{StaticResource TextMuted}"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center" />
                            <TextBox x:Name="SearchBox"
                                     Style="{StaticResource SearchBoxStyle}"
                                     Margin="30,0,9,0"
                                     TextChanged="SearchBox_TextChanged"
                                     AutomationProperties.Name="搜索窗口" />
                            <TextBlock x:Name="SearchHint"
                                       Text="搜索窗口"
                                       Margin="31,0,0,0"
                                       FontSize="12.5"
                                       Foreground="{StaticResource TextMuted}"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False" />
                        </Grid>
                    </Border>

                    <ListBox x:Name="WindowList"
                             Grid.Row="2"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ItemContainerStyle="{StaticResource WindowListItem}"
                             SelectionChanged="WindowList_SelectionChanged"
                             MouseDoubleClick="WindowList_MouseDoubleClick"
                             FocusVisualStyle="{x:Null}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:WindowInfo}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Grid Width="22" Height="22" VerticalAlignment="Top">
                                        <Border Background="#F0F3F7" CornerRadius="5" />
                                        <TextBlock Text="&#xE737;"
                                                   FontFamily="{StaticResource IconFont}"
                                                   FontSize="12"
                                                   Foreground="#7A8798"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                        <Image Source="{Binding Icon}"
                                               Width="16"
                                               Height="16"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Grid>

                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="12.5"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="NoWrap" />
                                        <TextBlock Text="{Binding Subtitle}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   Margin="0,3,0,0"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="NoWrap" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="60" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="56" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{StaticResource Panel}"
                        BorderBrush="{StaticResource Line}"
                        BorderThickness="0,0,0,1">
                    <Grid Margin="20,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Name="SelectedTitle"
                                       Text="未选择窗口"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap" />
                            <TextBlock x:Name="SelectedMeta"
                                       Text=""
                                       FontSize="11.5"
                                       Foreground="{StaticResource TextSecondary}"
                                       Margin="0,3,0,0"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap" />
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button x:Name="CopyButton"
                                    Style="{StaticResource SecondaryButton}"
                                    IsEnabled="False"
                                    Click="CopyButton_Click"
                                    ToolTip="复制当前画面"
                                    AutomationProperties.Name="复制当前画面">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8C8;"
                                               FontFamily="{StaticResource IconFont}"
                                               FontSize="13"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="复制" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="CaptureButton"
                                    Style="{StaticResource PrimaryButton}"
                                    Margin="8,0,0,0"
                                    IsEnabled="False"
                                    Click="CaptureButton_Click"
                                    ToolTip="截取所选窗口，快捷键 Ctrl+Alt+Shift+S"
                                    AutomationProperties.Name="截取所选窗口">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE722;"
                                               FontFamily="{StaticResource IconFont}"
                                               FontSize="13"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="截图" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Background="{StaticResource PreviewBg}" ClipToBounds="True">
                    <Grid>
                        <Image x:Name="PreviewImage"
                               Stretch="Uniform"
                               Margin="18"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               SnapsToDevicePixels="True" />

                        <StackPanel x:Name="EmptyState"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <TextBlock Text="&#xE737;"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="36"
                                       Foreground="#536071"
                                       HorizontalAlignment="Center" />
                            <TextBlock x:Name="EmptyText"
                                       Text="选择一个窗口"
                                       FontSize="13"
                                       Foreground="#8E99AA"
                                       Margin="0,10,0,0"
                                       HorizontalAlignment="Center" />
                        </StackPanel>

                        <Border x:Name="Toast"
                                Visibility="Collapsed"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,16"
                                Padding="12,7"
                                CornerRadius="6"
                                Background="#E619222D">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="ToastGlyph"
                                           Text="&#xE73E;"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="12"
                                           Foreground="#6EE7B7"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="ToastText"
                                           Foreground="White"
                                           FontSize="12"
                                           Margin="7,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Row="2"
                        Background="{StaticResource Panel}"
                        BorderBrush="{StaticResource Line}"
                        BorderThickness="0,1,0,0">
                    <Grid Margin="20,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="&#xE838;"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="14"
                                   Foreground="{StaticResource TextSecondary}"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="SaveFolderText"
                                   Grid.Column="1"
                                   FontSize="11.5"
                                   Foreground="{StaticResource TextSecondary}"
                                   Margin="8,0,12,0"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="2"
                                Content="更改"
                                Style="{StaticResource SecondaryButton}"
                                Height="30"
                                Padding="12,0"
                                Click="ChangeFolderButton_Click"
                                ToolTip="选择保存文件夹"
                                AutomationProperties.Name="选择保存文件夹" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2"
                Background="#EDF1F6"
                BorderBrush="{StaticResource Line}"
                BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusText"
                       Text="就绪"
                       FontSize="11.5"
                       Foreground="{StaticResource TextSecondary}"
                       Margin="16,0"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap" />
        </Border>
    </Grid>
</Window>
